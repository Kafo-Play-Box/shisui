tent": "preamble"}, "content": [{"tag": "details", "data": {"content": "details-entry-Grammar"}, "content": [{"tag": "summary", "data": {"content": "summary-entry"}, "content": "Grammar"}, {"tag": "div", "data": {"content": "Grammar-content"}, "content": "bank (plural banks)"}]}, {"tag": "details", "data": {"content": "details-entry-Etymology"}, "content": [{"tag": "summary", "data": {"content": "summary-entry"}, "content": "Etymology"}, {"tag": "div", "data": {"content": "Etymology-content"}, "content": "From Middle English bank, banke, from Old French banc (\u201cbench\u201d), from Frankish *banki, from Proto-Germanic *bankiz (\u201cbench\u201d). Akin to Old English ben\u010b (\u201cbench\u201d)."}]}]}]}, {"tag": "ol", "data": {"content": "glosses"}, "content": [{"tag": "li", "content": [{"tag": "div", "content": ["A row or panel of items stored or grouped together.", {"tag": "details", "data": {"content": "details-entry-examples"}, "content": [{"tag": "summary", "data": {"content": "summary-entry"}, "content": "2 examples"}, {"tag": "div", "data": {"content": "extra-info"}, "content": {"tag": "div", "data": {"content": "example-sentence"}, "content": [{"tag": "div", "data": {"content": "example-sentence-a"}, "content": "a bank of switches"}]}}, {"tag": "div", "data": {"content": "extra-info"}, "content": {"tag": "div", "data": {"content": "example-sentence"}, "content": [{"tag": "div", "data": {"content": "example-sentence-a"}, "content": "a bank of pay phones"}]}}]}]}]}, {"tag": "li", "content": [{"tag": "div", "content": ["A row of keys on a musical keyboard or the equivalent on a typewriter keyboard."]}]}, {"tag": "li", "content": [{"tag": "div", "content": [{"tag": "div", "data": {"content": "tags"}, "content": [{"tag": "span", "content": "comp", "title": "computing", "data": {"content": "tag", "category": ""}}]}, "A contiguous block of memory that is of fixed, hardware-dependent size, but often larger than a page and partitioning the memory such that two distinct banks do not overlap."]}]}, {"tag": "li", "content": [{"tag": "div", "content": ["(pinball) A set of multiple adjacent drop targets."]}]}]}, {"tag": "div", "data": {"content": "backlink"}, "content": [{"tag": "a", "href": "https://en.wiktionary.org/wiki/bank#English", "content": "Wiktionary"}]}]}]}, {"index": 4, "headwordIndices": [0], "dictionary": "kty-en-en", "dictionaryIndex": 2, "dictionaryAlias": "kty-en-en", "id": 2004007, "score": 0, "frequencyOrder": 0, "sequences": [0], "isPrimary": true, "tags": [{"name": "n", "category": "partOfSpeech", "order": -1, "score": 1, "content": ["noun"], "dictionaries": ["kty-en-en"], "redundant": true}], "entries": [{"type": "structured-content", "content": [{"tag": "div", "content": [{"tag": "div", "data": {"content": "preamble"}, "content": [{"tag": "details", "data": {"content": "details-entry-Grammar"}, "content": [{"tag": "summary", "data": {"content": "summary-entry"}, "content": "Grammar"}, {"tag": "div", "data": {"content": "Grammar-content"}, "content": "bank (plural banks)"}]}, {"tag": "details", "data": {"content": "details-entry-Etymology"}, "content": [{"tag": "summary", "data": {"content": "summary-entry"}, "content": "Etymology"}, {"tag": "div", "data": {"content": "Etymology-content"}, "content": "Probably from French banc. Of Germanic origin, and akin to English bench."}]}]}]}, {"tag": "ol", "data": {"content": "glosses"}, "content": [{"tag": "li", "content": [{"tag": "div", "content": ["A bench, as for rowers in a galley; also, a tier of oars.", {"tag": "details", "data": {"content": "details-entry-examples"}, "content": [{"tag": "summary", "data": {"content": "summary-entry"}, "content": "1 example"}, {"tag": "div", "data": {"content": "extra-info"}, "content": {"tag": "div", "data": {"content": "example-sentence"}, "content": [{"tag": "div", "data": {"content": "example-sentence-a"}, "content": "Placed on their banks, the lusty Trojans sweep / Neptune's smooth face, and cleave the yielding deep."}]}}]}]}]}, {"tag": "li", "content": [{"tag": "div", "content": ["A bench or seat for judges in court."]}]}, {"tag": "li", "content": [{"tag": "div", "content": ["The regular term of a court of law, or the full court sitting to hear arguments upon questions of law, as distinguished from a sitting at nisi prius, or a court held for jury trials. See banc"]}]}, {"tag": "li", "content": [{"tag": "div", "content": [{"tag": "div", "data": {"content": "tags"}, "content": [{"tag": "span", "content": "arch", "title": "archaic", "data": {"content": "tag", "category": "archaism"}}]}, "(printing) A kind of table used by printers."]}]}, {"tag": "li", "content": [{"tag": "div", "content": [{"tag": "div", "data": {"content": "tags"}, "content": [{"tag": "span", "content": "music", "title": "music", "data": {"content": "tag", "category": ""}}]}, "A bench, or row of keys belonging to a keyboard, as in an organ."]}]}]}, {"tag": "div", "data": {"content": "backlink"}, "content": [{"tag": "a", "href": "https://en.wiktionary.org/wiki/bank#English", "content": "Wiktionary"}]}]}]}, {"index": 5, "headwordIndices": [0], "dictionary": "kty-en-en", "dictionaryIndex": 2, "dictionaryAlias": "kty-en-en", "id": 2004008, "score": 0, "frequencyOrder": 0, "sequences": [0], "isPrimary": true, "tags": [{"name": "v", "category": "partOfSpeech", "order": -1, "score": 1, "content": ["verb"], "dictionaries": ["kty-en-en"], "redundant": false}], "entries": [{"type": "structured-content", "content": [{"tag": "div", "content": [{"tag": "div", "data": {"content": "preamble"}, "content": [{"tag": "details", "data": {"content": "details-entry-Grammar"}, "content": [{"tag": "summary", "data": {"content": "summary-entry"}, "content": "Grammar"}, {"tag": "div", "data": {"content": "Grammar-content"}, "content": "bank (third-person singular simple present banks, present participle banking, simple past and past participle banked)"}]}, {"tag": "details", "data": {"content": "details-entry-Etymology"}, "content": [{"tag": "summary", "data": {"content": "summary-entry"}, "content": "Etymology"}, {"tag": "div", "data": {"content": "Etymology-content"}, "content": "Etymology tree\nProto-Indo-European *b\u02b0eg-der.\nProto-Germanic *bankiz\nProto-West Germanic *banki\nLombardic bankbor.\nItalian bancabor.\nMiddle French banqueder.\nEnglish bank\nFrom Middle English banke, from Middle French banque, from Italian banca (\u201ccounter, moneychanger's bench or table\u201d), from Lombardic bank (\u201cbench, counter\u201d), from Proto-West Germanic *banki, from Proto-Germanic *bankiz (\u201cbench, counter\u201d), from Proto-Indo-European *b\u02b0eg- (\u201cto turn, curve, bend, bow\u201d). Doublet of bench, banc, and banco.\nFor the bench-bank relation, compare typologically Russian \u043b\u0430\u0301\u0432\u043a\u0430 (l\u00e1vka), \u043f\u0440\u0438\u043b\u0430\u0301\u0432\u043e\u043a (pril\u00e1vok)."}]}]}]}, {"tag": "ol", "data": {"content": "glosses"}, "content": [{"tag": "li", "content": [{"tag": "div", "content": [{"tag": "div", "data": {"content": "tags"}, "content": [{"tag": "span", "content": "vi", "title": "intransitive verb", "data": {"content": "tag", "category": "partOfSpeech"}}]}, "To deal with a bank or financial institution, or for an institution to provide financial services to a client.", {"tag": "details", "data": {"content": "details-entry-examples"}, "content": [{"tag": "summary", "data": {"content": "summary-entry"}, "content": "2 examples"}, {"tag": "div", "data": {"content": "extra-info"}, "content": {"tag": "div", "data": {"content": "example-sentence"}, "content": [{"tag": "div", "data": {"content": "example-sentence-a"}, "content": "He banked with Barclays."}]}}, {"tag": "div", "data": {"content": "extra-info"}, "content": {"tag": "div", "data": {"content": "example-sentence"}, "content": [{"tag": "div", "data": {"content": "example-sentence-a"}, "content": "the sort of face you would happily bank with"}]}}]}]}]}, {"tag": "li", "content": [{"tag": "div", "content": [{"tag": "div", "data": {"content": "tags"}, "content": [{"tag": "span", "content": "vt", "title": "transitive verb", "data": {"content": "tag", "category": "partOfSpeech"}}]}, "To put into a bank.", {"tag": "details", "data": {"content": "details-entry-examples"}, "content": [{"tag": "summary", "data": {"content": "summary-entry"}, "content": "1 example"}, {"tag": "div", "data": {"content": "extra-info"}, "content": {"tag": "div", "data": {"content": "example-sentence"}, "content": [{"tag": "div", "data": {"content": "example-sentence-a"}, "content": "I\u2019m going to bank the money."}]}}]}]}]}, {"tag": "li", "content": [{"tag": "div", "content": [{"tag": "div", "data": {"content": "tags"}, "content": [{"tag": "span", "content": "sl", "title": "slang", "data": {"content": "tag", "category": ""}}, {"tag": "span", "content": "vt", "title": "transitive verb", "data": {"content": "tag", "category": "partOfSpeech"}}]}, "To conceal in the rectum for use in prison.", {"tag": "details", "data": {"content": "details-entry-examples"}, "content": [{"tag": "summary", "data": {"content": "summary-entry"}, "content": "1 example"}, {"tag": "div", "data": {"content": "extra-info"}, "content": {"tag": "div", "data": {"content": "example-sentence"}, "content": [{"tag": "div", "data": {"content": "example-sentence-a"}, "content": "Johnny banked some coke for me."}]}}]}]}]}, {"tag": "li", "content": [{"tag": "div", "content": [{"tag": "div", "data": {"content": "tags"}, "content": [{"tag": "span", "content": "vt", "title": "transitive verb", "data": {"content": "tag", "category": "partOfSpeech"}}, {"tag": "span", "content": "fin", "title": "finance", "data": {"content": "tag", "category": ""}}]}, "To provide banking services to.", {"tag": "details", "data": {"content": "details-entry-examples"}, "content": [{"tag": "summary", "data": {"content": "summary-entry"}, "content": "2 examples"}, {"tag": "div", "data": {"content": "extra-info"}, "content": {"tag": "div", "data": {"content": "example-sentence"}, "content": [{"tag": "div", "data": {"content": "example-sentence-a"}, "content": "They proposed an ambitious plan to bank people in remote rural communities."}]}}, {"tag": "div", "data": {"content": "extra-info"}, "content": {"tag": "div", "data": {"content": "example-sentence"}, "content": [{"tag": "div", "data": {"content": "example-sentence-a"}, "content": "For quotations using this term, see Citations:bank."}]}}]}]}]}]}, {"tag": "div", "data": {"content": "backlink"}, "content": [{"tag": "a", "href": "https://en.wiktionary.org/wiki/bank#English", "content": "Wiktionary"}]}]}]}, {"index": 6, "headwordIndices": [0], "dictionary": "kty-en-en", "dictionaryIndex": 2, "dictionaryAlias": "kty-en-en", "id": 2004009, "score": 0, "frequencyOrder": 0, "sequences": [0], "isPrimary": true, "tags": [{"name": "v", "category": "partOfSpeech", "order": -1, "score": 1, "content": ["verb"], "dictionaries": ["kty-en-en"], "redundant": true}], "entries": [{"type": "structured-content", "content": [{"tag": "div", "content": [{"tag": "div", "data": {"content": "preamble"}, "content": [{"tag": "details", "data": {"content": "details-entry-Grammar"}, "content": [{"tag": "summary", "data": {"content": "summary-entry"}, "content": "Grammar"}, {"tag": "div", "data": {"content": "Grammar-content"}, "content": "bank (third-person singular simple present banks, present participle banking, simple past and past participle banked)"}]}, {"tag": "details", "data": {"content": "details-entry-Etymology"}, "content": [{"tag": "summary", "data": {"content": "summary-entry"}, "content": "Etymology"}, {"tag": "div", "data": {"content": "Etymology-content"}, "content": "From Middle English bank, banke, from Old English *banca (\u201cbench\u201d) (attested in Old English h\u014dbanca (\u201ccouch\u201d) and Old English banc (\u201cbank, hillock, embankment\u201d), from Proto-West Germanic *bank\u014d, from Proto-Germanic *bank\u00f4. Akin to Old Norse bakki (\u201celevation, hill\u